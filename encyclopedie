["Mille ans de souffrance","Taijutsu","Technique physique humoristique de Kakashi.","Aucun mudra",1000],
["Lotus initial","Taijutsu","Enchaînement aérien de taijutsu.","Aucun mudra",50000],
["Lotus inversé","Taijutsu","Technique reposant sur l'ouverture des portes internes.","Aucun mudra",180000],
["Paume du Hakke","Taijutsu","Frappe utilisant le style doux du clan Hyûga.","Aucun mudra",25000],
["Les 64 paumes du Hakke","Taijutsu","Enchaînement de frappes précises.","Aucun mudra",120000],
["Tourbillon divin du Hakke","Taijutsu","Crée une rotation de chakra protectrice.","Aucun mudra",150000],
["Poing du lion jumeau","Taijutsu","Concentre le chakra dans les mains.","Aucun mudra",130000],
["Réincarnation des morts","Ninjutsu interdit","Ramène les morts sous forme de combattants contrôlés.","Séquence rituelle",500000],
["Technique de transfert d'âme","Ninjutsu","Permet de déplacer l'esprit dans un autre corps.","Séquence variable",180000],
["Illusion démoniaque : arbre de la mort","Genjutsu","Plonge l'adversaire dans une illusion.","Séquence variable",70000],
["Illusion démoniaque : descente de l'enfer","Genjutsu","Fait croire à la cible qu'une boule de feu tombe sur elle.","Séquence variable",60000],
["Lecture de l'esprit","Ninjutsu","Permet d'explorer les souvenirs d'une personne.","Aucun mudra fixe",100000]

];

// VARIANTES POUR ATTEINDRE 500 FICHES

const elements=[
 ["Feu","Katon"],
 ["Vent","Fūton"],
 ["Foudre","Raiton"],
 ["Eau","Suiton"],
 ["Terre","Doton"]
];

const variantes=[
 ["lame","Concentre le chakra élémentaire en une lame."],
 ["dragon","Crée une forme de dragon élémentaire."],
 ["mur","Érige une protection élémentaire."],
 ["sphère","Concentre l'énergie en une sphère."],
 ["rafale","Projette une puissante attaque élémentaire."],
 ["prison","Enferme la cible dans une structure élémentaire."],
 ["tempête","Déchaîne une puissante attaque sur une zone."],
 ["aiguilles","Projette plusieurs projectiles élémentaires."],
 ["barrière","Crée une protection autour de l'utilisateur."],
 ["explosion","Libère une puissante décharge élémentaire."]
];

let numeroVariante=1;

while(base.length<500){
 const i=numeroVariante-1;
 const el=elements[i%elements.length];
 const v=variantes[Math.floor(i/elements.length)%variantes.length];

 base.push([
  `Variante fictive ${numeroVariante} : technique ${v[0]} ${el[1]}`,
  el[0],
  v[1],
  "Séquence non établie",
  30000+((numeroVariante*7919)%970000),
  true
 ]);
 numeroVariante++;
}

// AFFICHAGE

const nomsElements={
 Feu:"Katon",
 Vent:"Fūton",
 Foudre:"Raiton",
 Eau:"Suiton",
 Terre:"Doton"
};

const techniques=base.map((t,i)=>({
 id:i+1,
 nom:t[0],
 categorie:t[1],
 description:t[2],
 mudras:t[3],
 chakra:t[4],
 fictive:t[5]===true
}));

const liste=document.getElementById("liste");
const recherche=document.getElementById("recherche");
const compteur=document.getElementById("compteur");
const boutons=document.querySelectorAll(".filtre");

let filtreActif="Tous";

boutons.forEach(b=>{
 b.addEventListener("click",()=>{
  filtreActif=b.dataset.filtre;
  boutons.forEach(x=>x.classList.remove("actif"));
  b.classList.add("actif");
  afficher();
 });
});

function formater(n){
 return n.toLocaleString("fr-FR");
}

function afficher(){
 const terme=recherche.value.trim().toLocaleLowerCase("fr");

 const resultats=techniques.filter(t=>{
  const texte=[
   t.nom,t.categorie,t.description,t.mudras,t.chakra,
   nomsElements[t.categorie]||""
  ].join(" ").toLocaleLowerCase("fr");

  return texte.includes(terme)&&
   (filtreActif==="Tous"||t.categorie===filtreActif);
 });

 compteur.textContent=
 `${resultats.length} résultat(s) — ${techniques.length} techniques au total`;

 liste.innerHTML="";

 if(resultats.length===0){
  const vide=document.createElement("p");
  vide.className="vide";
  vide.textContent="Aucune technique trouvée.";
  liste.appendChild(vide);
  return;
 }

 resultats.forEach(t=>{
  const carte=document.createElement("article");
  carte.className="technique";

  const titre=document.createElement("h2");
  titre.textContent=t.nom;

  const categorie=document.createElement("p");
  categorie.className="categorie";
  categorie.textContent=
   `Nature : ${nomsElements[t.categorie]||t.categorie}`;

  const description=document.createElement("p");
  description.textContent=t.description;

  const mudras=document.createElement("p");
  mudras.className="mudras";
  mudras.textContent=`🤞 Mudras : ${t.mudras}`;

  const chakra=document.createElement("p");
  chakra.className="chakra";
  chakra.textContent=
   `⚡ Coût estimé : ${formater(t.chakra)} / 1 000 000`;

  const barre=document.createElement("div");
  barre.className="barre";

  const progression=document.createElement("div");
  progression.className="progression";
  progression.style.width=
   `${Math.min(100,t.chakra/10000)}%`;

  barre.appendChild(progression);

  carte.append(titre,categorie,description,mudras,chakra,barre);

  if(t.fictive){
   const badge=document.createElement("span");
   badge.className="type";
   badge.textContent="Variante fictive";
   carte.appendChild(badge);
  }

  liste.appendChild(carte);
 });
}

recherche.addEventListener("input",afficher);
afficher();

</script>
</body>
</html>

